# Runtime
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/abdulmula_erp_dev

# Generate two different cryptographically random secrets. Never commit real values.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Frontend origins (exact origins only; no paths or trailing slashes).
CLIENT_URL=http://localhost:5173
CLIENT_PREVIEW_URL=
FRONTEND_URL=http://localhost:5173

# Transactional email — disabled by default; see docs/email-delivery-setup.md.
EMAIL_DELIVERY_MODE=disabled
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
EMAIL_TEST_RECIPIENTS=
EMAIL_SENDING_DOMAIN=
EMAIL_DOMAIN_VERIFIED=false

# One-time local administrator bootstrap only. Set explicitly when needed,
# run npm run create-admin, then remove ADMIN_PASSWORD from the environment.
ADMIN_NAME=Abdulmula Fashion Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
