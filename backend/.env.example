# Exact production frontend origin (no path or trailing slash).
CLIENT_URL=https://abdulmula-fashion-erp.vercel.app

# Optional comma-separated exact origins for additional approved frontends.
# This project's Vercel preview deployments and http://localhost:5173 are
# allowed by the backend CORS policy without listing each deployment URL.
CLIENT_PREVIEW_URL=


# Transactional email (set in backend deployment environment; never commit real secrets)
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
FRONTEND_URL=https://abdulmula-fashion-erp.vercel.app
